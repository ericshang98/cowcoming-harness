# Optional. The default demo needs no credentials or model download.
HARNESS_PORT=4186
HARNESS_MODEL_PROVIDER=ollama
HARNESS_MODEL_ENDPOINT=http://127.0.0.1:11434/api/chat
HARNESS_MODEL_NAME=
HARNESS_MODEL_KEY=
# Use openai-compatible with an explicit /v1/chat/completions endpoint for cloud providers.
# Hardware is never activated by installing dependencies or opening the page.
HARNESS_ENABLE_HARDWARE=0
BENBEN_ENDPOINT=http://127.0.0.1:8766/
BENBEN_SESSION_TOKEN=
